{
  "name": "Arcade API",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {}
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Arcade API",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "python -m pip install -r requirements.txt -r requirements-dev.txt"
}
